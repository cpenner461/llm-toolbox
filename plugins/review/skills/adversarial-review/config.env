# Settings for the adversarial-review skill.
#
# Standard review: the `model:` line in each agent file sets the Claude reviewer model:
#   plugins/review/agents/adversarial-reviewer-correctness.md   (default: opus)
#   plugins/review/agents/adversarial-reviewer-design.md        (default: sonnet)
# Use different models for the two reviewers. Different models make different mistakes.
#
# Deep review: the skill reads the REVIEW_DEEP_* lines and uses these models for that run only.
# The verification reviewer uses the correctness model.
REVIEW_DEEP_CORRECTNESS_MODEL=fable
REVIEW_DEEP_DESIGN_MODEL=opus

# This section contains all settings for the Codex reviewer. scripts/codex-review.sh reads it.

# 1: run the Codex reviewer if the codex CLI is installed and logged in. 0: do not run it.
CODEX_REVIEW_ENABLED=1

# Model for `codex exec -m`. If empty, Codex uses the default in ~/.codex/config.toml.
CODEX_REVIEW_MODEL=""

# More `codex exec -c key=value` settings. Put a space between settings.
# Example: CODEX_REVIEW_EXTRA_CONFIG="model_reasoning_effort=high"
CODEX_REVIEW_EXTRA_CONFIG=""

# Deep review: these replace the two settings above. If empty, the standard value applies.
CODEX_REVIEW_DEEP_MODEL=""
CODEX_REVIEW_DEEP_EXTRA_CONFIG="model_reasoning_effort=high"

# 0: Codex saves the session log in ~/.codex/sessions. Usage tools can read its token counts,
#    and `codex resume` can open it. A later review does not read the log.
# 1: run with --ephemeral. Codex saves no session log.
# If you turn on the Codex `memories` feature, set 1. Codex builds memories from saved sessions,
# so findings from one review could reach later reviews and break their independence.
CODEX_REVIEW_EPHEMERAL=0

# Time limit for the Codex run, in seconds. At this limit, the script stops Codex.
CODEX_REVIEW_TIMEOUT=900
